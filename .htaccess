<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si le fichier ou le dossier demandé existe à la racine, on le sert directement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Sinon, on redirige tout vers le dossier public/index.php
    RewriteRule ^(.*)$ public/index.php?route=$1 [QSA,L]
</IfModule>